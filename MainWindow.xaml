<Window x:Class="Bokhandel_WPF_Applikation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        Title="Bokhandel – Lagersaldo"
        Height="550"
        Width="900"
        FontFamily="Arial"
        FontSize="13">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0"
              Background="#5E8C61"
              Foreground="White">

            <MenuItem Header="_Alternativ">

                <MenuItem Header="Lägg till bok"
                 Icon="{fa:Icon book}"
                          IsEnabled="False"
                          Foreground="Black"
                          />
                

                <MenuItem Header="_Uppdatera databas"
                          Command="{Binding RefreshCommand}"
                Icon="{fa:Icon arrowrotateright}"
                          Foreground="Black"
                          />

                <MenuItem Header="Avsluta"
                          Command="{Binding ExitCommand}" 
                          Icon="{fa:Icon dooropen}"
                          Foreground="Black"
                          />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Foreground="#5E8C61"
                       Text="Lagersaldo per butik"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,12"/>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding StockItems}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      Background="White"
                      BorderBrush="Black"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#F8F9FA"
                      Margin="0,0,0,12">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Butik"
                                        Binding="{Binding Butiks.Butiksnamn}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Titel"
                                        Binding="{Binding Isbn13Navigation.Titel}"
                                        Width="3*"/>

                    <DataGridTextColumn Header="Författare"
                                        Binding="{Binding Isbn13Navigation.FörfattareFulltNamn}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Antal böcker"
                                        Binding="{Binding Antal}"
                                        Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Row="2"
                    BorderBrush="Black"
                    Background="White"
                    BorderThickness="1"
                    Padding="12"
                    CornerRadius="6">

                <StackPanel Orientation="Vertical">

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Butik:"
                                   Width="60"
                                   VerticalAlignment="Center"/>

                        <ComboBox Width="220"
                                  ItemsSource="{Binding Stores}"
                                  SelectedItem="{Binding SelectedStore}"
                                  DisplayMemberPath="Butiksnamn"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Bok:"
                                   Width="60"
                                   VerticalAlignment="Center"/>

                        <ComboBox Width="360"
                                  ItemsSource="{Binding Books}"
                                  SelectedItem="{Binding SelectedBook}"
                                  DisplayMemberPath="Titel"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Antal:"
                                   Width="60"
                                   VerticalAlignment="Center"/>

                        <TextBox Width="80"
                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button Content="Lägg till"
                                Width="110"
                                Margin="12,0,0,0"
                                Background="#2F80ED"
                                Foreground="White"
                                Command="{Binding AddCommand}"/>

                        <Button Content="Ta bort"
                                Width="110"
                                Margin="8,0,0,0"
                                Background="#6C757D"
                                Foreground="White"
                                Command="{Binding RemoveCommand}"/>
                    </StackPanel>

                </StackPanel>
            </Border>

        </Grid>
    </Grid>
</Window>